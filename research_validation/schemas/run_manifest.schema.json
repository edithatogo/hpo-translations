{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpo-translations.example/schemas/run_manifest.schema.json",
  "title": "Research run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "protocol_version", "hpo_release", "source_versions", "model_runs", "random_seed", "generated_at", "validation_commands", "restricted_inputs_present", "local_only_manifest", "empirical_record_count", "human_reviewed_record_count", "approvals", "release_scope", "promotion_policy"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "protocol_version": {"type": "string", "minLength": 1},
    "hpo_release": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "model_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "model", "version", "prompt_version", "temperature"],
        "properties": {
          "system": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "prompt_version": {"type": "string", "minLength": 1},
          "temperature": {"type": "number", "minimum": 0}
        }
      }
    },
    "random_seed": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "validation_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "restricted_inputs_present": {"type": "boolean"},
    "local_only_manifest": {"type": ["string", "null"]},
    "empirical_record_count": {"type": "integer", "minimum": 0},
    "human_reviewed_record_count": {"type": "integer", "minimum": 0},
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "ethics", "community", "language_working_group"],
      "properties": {
        "license": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "ethics": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "community": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "language_working_group": {"enum": ["not_required", "pending", "approved", "rejected"]}
      }
    },
    "release_scope": {"enum": ["schema_probe", "pilot", "confirmatory"]},
    "promotion_policy": {"const": "human_authorization_required"}
  },
  "allOf": [
    {
      "if": {"properties": {"restricted_inputs_present": {"const": true}}, "required": ["restricted_inputs_present"]},
      "then": {"properties": {"local_only_manifest": {"type": "string", "minLength": 1}}}
    }
  ]
}
