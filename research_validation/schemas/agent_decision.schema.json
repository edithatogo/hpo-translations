{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpo-translations.example/schemas/agent_decision.schema.json",
  "title": "Agent panel decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "decision_id", "item_id", "agent_role_id", "agent_roles", "protocol_attestation_id", "conflict_status", "conflict_details", "blinded_to_candidate_method", "decision", "edited_text", "edit_burden", "clinically_significant_error", "error_categories", "error_explanation", "review_seconds", "confidence", "selected_hpo_id", "ontology_discrimination_correct", "adjudication_status"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "decision_id": {"type": "string", "pattern": "^decision-[a-z0-9-]+$"},
    "item_id": {"type": "string", "pattern": "^item-[a-z0-9-]+$"},
    "agent_role_id": {"enum": ["target_language_semantics", "clinical_safety", "ontology_semantics", "provenance_and_rights", "adversarial_error_finder", "independent_adjudicator"]},
    "agent_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["language_semantics", "clinical_safety", "ontology_semantics", "provenance_rights", "adversarial_review", "adjudication"]}},
    "protocol_attestation_id": {"type": "string", "minLength": 1},
    "conflict_status": {"enum": ["none_declared", "disclosed", "recused"]},
    "conflict_details": {"type": ["string", "null"]},
    "blinded_to_candidate_method": {"const": true},
    "decision": {"enum": ["accept_no_edit", "accept_with_edit", "reject", "abstain"]},
    "edited_text": {"type": ["string", "null"]},
    "edit_burden": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["character_distance", "normalized_character_distance", "token_distance", "normalized_token_distance"],
      "properties": {
        "character_distance": {"type": "integer", "minimum": 0},
        "normalized_character_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "token_distance": {"type": "integer", "minimum": 0},
        "normalized_token_distance": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "clinically_significant_error": {"type": "boolean"},
    "error_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["polarity", "anatomy", "laterality", "severity_frequency", "temporal_course", "inheritance_causality", "granularity", "omission", "addition", "ambiguity", "misleading_cognate", "register", "regional_mismatch", "grammar", "other"]}},
    "error_explanation": {"type": ["string", "null"]},
    "review_seconds": {"type": "number", "minimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "selected_hpo_id": {"type": ["string", "null"], "pattern": "^HP:[0-9]{7}$"},
    "ontology_discrimination_correct": {"type": ["boolean", "null"]},
    "adjudication_status": {"enum": ["pending", "agreed", "adjudicated", "withdrawn"]}
  },
  "allOf": [
    {
      "if": {"properties": {"conflict_status": {"const": "disclosed"}}, "required": ["conflict_status"]},
      "then": {"properties": {"conflict_details": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"decision": {"const": "accept_with_edit"}}, "required": ["decision"]},
      "then": {"properties": {"edited_text": {"type": "string", "minLength": 1}, "edit_burden": {"type": "object"}}}
    },
    {
      "if": {"properties": {"error_categories": {"contains": {"const": "other"}}}, "required": ["error_categories"]},
      "then": {"properties": {"error_explanation": {"type": "string", "minLength": 1}}}
    }
  ]
}
