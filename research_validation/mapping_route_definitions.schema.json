{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/hpo-translations/research_validation/mapping_route_definitions.schema.json",
  "title": "Governed ontology mapping route definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "scope", "nodes", "composition_policies", "atomic_assertions", "artifact_dispositions", "admission_boundary"],
  "properties": {
    "schema_version": {"const": "mapping-route-definitions-v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 28,
      "items": {"$ref": "#/$defs/node"}
    },
    "atomic_assertions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assertion"}
    },
    "composition_policies": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/compositionPolicy"}
    },
    "artifact_dispositions": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/artifactDisposition"}
    },
    "admission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_only", "payloads_included", "hyperedge_cliques_forbidden", "shared_labels_create_edges", "routes_authorize_payload_use"],
      "properties": {
        "metadata_only": {"const": true},
        "payloads_included": {"const": false},
        "hyperedge_cliques_forbidden": {"const": true},
        "shared_labels_create_edges": {"const": false},
        "routes_authorize_payload_use": {"const": false}
      }
    }
  },
  "$defs": {
    "catalogReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "record_id"],
      "properties": {
        "catalog": {
          "enum": ["ontology_network/source_registry.json", "research_validation/supplementary_source_access_reviews.json", "research_validation/source_catalog.json", "research_validation/terminology_node_registry.json"]
        },
        "record_id": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "name", "aliases", "domain", "catalog_references", "artifact_status"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "domain": {
          "enum": ["phenotype", "disease", "anatomy", "cell", "clinical-terminology", "classification", "measurement", "adverse-event", "oncology", "multidomain", "quality", "rare-disease"]
        },
        "catalog_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/catalogReference"}},
        "artifact_status": {"enum": ["artifact_documented", "no_artifact"]},
        "no_artifact_status": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_status": {"const": "no_artifact"}}},
          "then": {"required": ["no_artifact_status"]},
          "else": {"not": {"required": ["no_artifact_status"]}}
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "subject_node_id", "object_node_id", "artifact_id", "route_class", "direction", "status", "lineage_group", "predicate", "mapping_unit", "reversal_policy", "composition_policy_id", "semantic_loss", "evidence_refs", "artifact_release_ref", "artifact_integrity_ref", "artifact_rights_ref", "payload_policy_ref", "independent_evidence_group", "origin_authority", "derivation"],
      "properties": {
        "assertion_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "subject_node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "object_node_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "route_class": {"enum": ["curated-crosswalk", "source-xref", "lexical-candidate", "compositional", "classification-map", "ontology-bridge"]},
        "direction": {"const": "directed"},
        "status": {"enum": ["metadata-only-payload-blocked", "metadata-only-rights-review-required", "metadata-only-access-required"]},
        "lineage_group": {"type": "string", "minLength": 1},
        "predicate": {"enum": ["skos:exactMatch", "skos:closeMatch", "skos:relatedMatch", "oboInOwl:hasDbXref", "sssom:compositionalMapping", "sssom:classificationMap", "rdfs:seeAlso"]},
        "mapping_unit": {"enum": ["class-to-class", "class-to-code", "compositional-expression"]},
        "reversal_policy": {"enum": ["forbidden", "separate-evidence-required"]},
        "composition_policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "semantic_loss": {"enum": ["none-asserted", "possible", "expected", "unknown"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_release_ref": {"type": "string", "minLength": 1},
        "artifact_integrity_ref": {"type": "string", "minLength": 1},
        "artifact_rights_ref": {"type": "string", "minLength": 1},
        "payload_policy_ref": {"type": "string", "minLength": 1},
        "independent_evidence_group": {"type": "string", "minLength": 1},
        "origin_authority": {"type": "string", "minLength": 1},
        "derivation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "compositionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "transitive", "allowed_route_classes", "max_hops", "description"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "transitive": {"type": "boolean"},
        "allowed_route_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["curated-crosswalk", "source-xref", "lexical-candidate", "compositional", "classification-map", "ontology-bridge"]}},
        "max_hops": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "artifactDisposition": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "catalog", "disposition", "reason", "assertion_ids"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "catalog": {"enum": ["mapping_expansion_catalog", "source_catalog"]},
        "disposition": {"enum": ["asserted", "inventory-only", "duplicate-catalog-record"]},
        "reason": {"type": "string", "minLength": 1},
        "assertion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
