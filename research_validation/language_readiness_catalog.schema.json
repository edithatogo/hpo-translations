{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpo-translations.example/language_readiness_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","generated_at","scope","translation_rows_added","source_payload_rows_added","hpo_candidate_languages","regional_contexts","decs","pro_ctcae","admission_boundary"],
  "properties": {
    "schema_version": {"const":"language-readiness-catalog-v1"},
    "generated_at": {"type":"string","format":"date-time"},
    "scope": {"const":"metadata_only_no_translation_or_source_payload_rows"},
    "translation_rows_added": {"const":0},
    "source_payload_rows_added": {"const":0},
    "hpo_candidate_languages": {"type":"array","minItems":5,"items":{"type":"object","additionalProperties":false,"required":["language","status","evidence_sources","source_payload_authorized","community_use_authorized"],"properties":{"language":{"type":"string"},"status":{"const":"metadata_candidate_no_hpo_asset"},"evidence_sources":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":1}},"source_payload_authorized":{"const":false},"community_use_authorized":{"const":false}}}},
    "regional_contexts": {"type":"array","minItems":6,"items":{"type":"object","additionalProperties":false,"required":["language_family","tags"],"properties":{"language_family":{"type":"string"},"tags":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["tag","evidence_status","evidence_sources"],"properties":{"tag":{"type":"string"},"evidence_status":{"enum":["confirmed_public_metadata","context_requested_source_pin_required","script_context_requires_source_specific_pin"]},"evidence_sources":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}}}}},
    "decs": {"$ref":"#/$defs/gatedSource"},
    "pro_ctcae": {"type":"object","additionalProperties":false,"required":["catalog_completeness","authority_last_updated","validated_translations","in_development","evidence_urls","permission_status","payload_retrieval_allowed","payload_commit_allowed","translation_use_allowed"],"properties":{"catalog_completeness":{"const":"exhaustive_authority_table_as_of_2026-08-11"},"authority_last_updated":{"const":"2026-08-11"},"validated_translations":{"type":"array","minItems":76,"maxItems":76,"uniqueItems":true,"items":{"$ref":"#/$defs/validatedTranslation"}},"in_development":{"type":"object","additionalProperties":false,"required":["catalog_completeness","authority_last_updated","pro_ctcae","ped_pro_ctcae_separate_module","availability_status"],"properties":{"catalog_completeness":{"const":"exhaustive_authority_list_as_of_2026-08-11"},"authority_last_updated":{"const":"2026-08-11"},"pro_ctcae":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"$ref":"#/$defs/developmentRecord"}},"ped_pro_ctcae_separate_module":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/developmentRecord"}},"availability_status":{"const":"in_development_not_validated_or_available"}}},"evidence_urls":{"type":"array","minItems":5,"uniqueItems":true,"items":{"type":"string","format":"uri"}},"permission_status":{"type":"string","minLength":1},"payload_retrieval_allowed":{"const":false},"payload_commit_allowed":{"const":false},"translation_use_allowed":{"const":false}}},
    "admission_boundary": {"type":"object","additionalProperties":false,"required":["metadata_is_not_language_profile_authority","regional_context_is_not_translation_coverage","candidate_language_is_not_approved_hpo_translation","country_or_in_development_status_must_not_be_inferred"],"properties":{"metadata_is_not_language_profile_authority":{"const":true},"regional_context_is_not_translation_coverage":{"const":true},"candidate_language_is_not_approved_hpo_translation":{"const":true},"country_or_in_development_status_must_not_be_inferred":{"const":true}}}
  },
  "$defs": {
    "gatedSource": {"type":"object","additionalProperties":false,"required":["catalog_completeness","languages","evidence_urls","permission_status","payload_retrieval_allowed","payload_commit_allowed","translation_use_allowed"],"properties":{"catalog_completeness":{"const":"documented_service_language_set"},"languages":{"type":"array","minItems":4,"uniqueItems":true,"items":{"type":"string"}},"evidence_urls":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","format":"uri"}},"permission_status":{"type":"string","minLength":1},"payload_retrieval_allowed":{"const":false},"payload_commit_allowed":{"const":false},"translation_use_allowed":{"const":false}}},
    "validatedTranslation": {"type":"object","additionalProperties":false,"required":["authority_name","language_tag","countries_tested"],"properties":{"authority_name":{"type":"string","minLength":1},"language_tag":{"type":"string","pattern":"^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"},"countries_tested":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"country_note":{"type":"string","minLength":1},"repository_profile_linkage":{"const":"unresolved_do_not_link_to_hp_tw"}}},
    "developmentRecord": {"type":"object","additionalProperties":false,"required":["authority_name","language_tag","countries"],"properties":{"authority_name":{"type":"string","minLength":1},"language_tag":{"type":"string","pattern":"^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"},"countries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}
  }
}
