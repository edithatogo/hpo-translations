{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "release", "release_date", "status", "official_statistics_url", "official_appendix_url", "language_count", "languages", "regional_loinc_2_82_editions", "canadian_french_source", "mapping_policy", "payload_policy"],
  "properties": {
    "schema_version": {"const": "umls-public-metadata-inventory-v1"},
    "status": {"const": "metadata_inventory_complete_payload_not_ingested"},
    "release": {"type": "string", "minLength": 1},
    "release_date": {"type": "string", "format": "date"},
    "official_statistics_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "official_appendix_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "language_count": {"type": "integer", "minimum": 1},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["umls_code", "bcp47", "name"], "properties": {"umls_code": {"type": "string", "pattern": "^[A-Z]{3}$"}, "bcp47": {"type": "string", "minLength": 2}, "name": {"type": "string", "minLength": 1}}}},
    "regional_loinc_2_82_editions": {"type": "array", "items": {"type": "string"}},
    "canadian_french_source": {"type": "object", "required": ["source_version", "language", "producer", "scope"]},
    "mapping_policy": {"type": "object"},
    "payload_policy": {"type": "object", "required": ["payload_incorporated", "restricted_payloads", "requirements"], "properties": {"payload_incorporated": {"const": false}}}
  }
}
