{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "payload_incorporated", "variant_profiles", "mapping_profiles", "discovery_candidates", "hpo_mapping_policy"],
  "properties": {
    "schema_version": {"const": "icd10-national-variant-inventory-v1"},
    "status": {"const": "catalogued_metadata_only"},
    "payload_incorporated": {"const": false},
    "variant_profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["profile_id", "jurisdiction", "classification", "release", "languages", "role", "authority_url", "licence_gate"], "properties": {"profile_id": {"type": "string", "minLength": 1}, "release": {"type": "string", "minLength": 1}, "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "licence_gate": {"type": "string", "minLength": 1}}}},
    "mapping_profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["map_id", "direction", "languages", "authority_url", "licence_gate"], "properties": {"map_id": {"type": "string", "minLength": 1}, "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "licence_gate": {"type": "string", "minLength": 1}, "release": {"type": ["string", "null"]}, "release_date": {"type": "string", "format": "date"}, "release_status": {"type": "string"}}}},
    "discovery_candidates": {"type": "array"},
    "hpo_mapping_policy": {"type": "object", "required": ["direct_official_hpo_icd10_map_found"], "properties": {"direct_official_hpo_icd10_map_found": {"const": false}}}
  }
}
